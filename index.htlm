        <path d="M16 15l4 1"/>
      </svg>
      <div class="reagent-name">Slide Agglutination</div>
      <div class="reagent-desc">Fast, reliable latex agglutination tests for serological screening.</div>
      <span class="reagent-arrow">↗</span>
    </a>
    <!-- Card 4 -->
    <a href="#" class="reagent-card">
      <svg class="reagent-icon" viewBox="0 0 36 36" fill="none" stroke="#c8a84b" stroke-width="1.2">
