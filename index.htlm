<!-- ABOUT -->
<section class="about" id="about">
  <div>
    <div class="section-eyebrow">Who We Are</div>
    <h2 class="section-title">An experienced team<br>of <em>diagnostic</em> professionals</h2>
    <p class="section-body">
      We provide laboratories worldwide with a wide range of reliable reagents 
      and instrumentation for disease screening and diagnosis. Our roots are Italian, 
      our reach is global.
    </p>
  </div>

  <div class="about-pillars">
    <div class="pillar">
      <div class="pillar-num">01</div>
      <div class="pillar-content">
        <div class="pillar-title">European Quality</div>
        <div class="pillar-text">All products comply with EU IVD Directive standards, certified by accredited third-party bodies for safety and performance.</div>
      </div>
    </div>
    <div class="pillar">
      <div class="pillar-num">02</div>
      <div class="pillar-content">
        <div class="pillar-title">Global Distribution</div>
        <div class="pillar-text">From our manufacturing site in Caserta to laboratories across the world — efficient logistics and reliable supply chains.</div>
      </div>
    </div>
    <div class="pillar">
      <div class="pillar-num">03</div>
      <div class="pillar-content">
        <div class="pillar-title">Flexible Production</div>
        <div class="pillar-text">Adaptable formulation and packaging to meet the specific needs of each partner, from small clinics to large hospital facilities.</div>
      </div>
    </div>
  </div>
</section>

<!-- PRODUCTS -->
<section class="products" id="products">
  <div class="products-header">
    <div>
      <div class="section-eyebrow">Our Reagents</div>
