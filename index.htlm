<!-- INSTRUMENTS -->
<section class="instruments" id="instruments">
  <div class="section-eyebrow">Our Instruments</div>
  <h2 class="section-title">Two lines of devices,<br><em>proven</em> performance</h2>
  <p class="section-body" style="margin-top:0.8rem;">
    Thoroughly selected and tested by our QC and technical engineers, certified to European electrical safety and electromagnetic standards.
  </p>

  <div class="instruments-grid">
    <div class="instr-card">
      <div class="instr-category">Line 01</div>
      <div class="instr-title">Clinical Chemistry Analysers</div>
      <div class="instr-text">
        A range of semi-automatic and fully-automated biochemistry analysers, 
        from compact benchtop models ideal for small clinics to high-throughput 
        platforms for large hospital laboratories.
      </div>
      <div class="instr-features">
        <div class="instr-feature">Compact &amp; high-throughput options</div>
        <div class="instr-feature">Optimised for MTD reagent portfolio</div>
        <div class="instr-feature">CE-marked &amp; EMC certified</div>
        <div class="instr-feature">Full technical support</div>
      </div>
    </div>
    <div class="instr-card">
      <div class="instr-category">Line 02</div>
      <div class="instr-title">Hematology Analysers</div>
      <div class="instr-text">
        3-diff and 5-diff hematology counters designed for daily laboratory 
        routine, delivering reliable CBC results with user-friendly interfaces 
        and low maintenance requirements.
      </div>
      <div class="instr-features">
        <div class="instr-feature">3-diff and 5-diff platforms</div>
        <div class="instr-feature">Touch-screen interface</div>
        <div class="instr-feature">LIS connectivity</div>
        <div class="instr-feature">Low reagent consumption</div>
      </div>
    </div>
  </div>
</section>

