  </div>

  <div class="contact-form">
    <div class="form-row">
      <div class="form-group">
        <label class="form-label">First Name</label>
        <input class="form-input" type="text" placeholder="Maria">
      </div>
      <div class="form-group">
        <label class="form-label">Last Name</label>
        <input class="form-input" type="text" placeholder="Rossi">
      </div>
    </div>
    <div class="form-group">
      <label class="form-label">Email</label>
      <input class="form-input" type="email" placeholder="lab@hospital.com">
    </div>
    <div class="form-group">
      <label class="form-label">Organisation</label>
      <input class="form-input" type="text" placeholder="Hospital / Laboratory">
    </div>
    <div class="form-group">
      <label class="form-label">Interest</label>
      <select class="form-input" style="appearance:none; cursor:pointer;">
        <option value="" style="background:#0b1a2e">Select a product category…</option>
        <option style="background:#0b1a2e">Clinical Chemistry</option>
        <option style="background:#0b1a2e">Turbidimetry</option>
        <option style="background:#0b1a2e">Coagulation</option>
        <option style="background:#0b1a2e">Hematology</option>
        <option style="background:#0b1a2e">Instruments</option>
        <option style="background:#0b1a2e">Other</option>
      </select>
    </div>
    <div class="form-group">
      <label class="form-label">Message</label>
      <textarea class="form-textarea" placeholder="Tell us how we can help…"></textarea>
    </div>
    <div style="display:flex; align-items:center; gap:0.6rem; font-size:0.72rem; color:var(--muted);">
      <input type="checkbox" id="privacy" style="accent-color:var(--gold)">
      <label for="privacy">I accept the <a href="#" style="color:var(--gold); text-decoration:none;">Privacy Policy</a></label>
    </div>
    <button class="btn-primary" style="align-self:flex-start; margin-top:0.5rem;">Send Message →</button>
  </div>
</section>

