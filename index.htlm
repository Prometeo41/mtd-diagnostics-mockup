    <!-- Card 5 -->
    <a href="#" class="reagent-card">
      <svg class="reagent-icon" viewBox="0 0 36 36" fill="none" stroke="#c8a84b" stroke-width="1.2">
        <path d="M18 6 L30 30 L6 30 Z"/><line x1="12" y1="22" x2="24" y2="22"/>
        <line x1="15" y1="16" x2="21" y2="16"/>
      </svg>
      <div class="reagent-name">Controls &amp; Calibrators</div>
      <div class="reagent-desc">Multi-analyte controls and calibrators for QC and instrument setup.</div>
